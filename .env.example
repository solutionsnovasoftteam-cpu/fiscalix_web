# Supabase (servidor)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_clave_publicable
SUPABASE_SERVICE_ROLE_KEY=tu_clave_de_servicio

# Firebase Admin (servidor)
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Authentication (servidor, Configuración del proyecto > General > SDK web)
FIREBASE_WEB_API_KEY=tu_api_key_web
# Opcional. Si se omite, Fiscalix usa FIREBASE_PROJECT_ID.firebaseapp.com
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com

# URL base de la app para enlaces de verificación de correo
# Desarrollo: http://localhost:3000
# Producción: http://fiscalix.novasoftsl.com
APP_URL=http://localhost:3000

# Tipos de cambio informativos para mostrar importes en otras divisas.
# La base contable de Fiscalix sigue siendo MXN.
NEXT_PUBLIC_FISCALIX_USD_MXN_RATE=18.50
NEXT_PUBLIC_FISCALIX_EUR_MXN_RATE=20.10

# Gmail API para Centro de aclaraciones (servidor)
# Genera el refresh token con estos scopes:
# https://www.googleapis.com/auth/gmail.readonly
# https://www.googleapis.com/auth/gmail.send
GMAIL_SUPPORT_EMAIL=solutionsnovasoftteam@gmail.com
GMAIL_SUPPORT_QUERY="in:inbox -category:promotions -category:social"
GMAIL_OAUTH_CLIENT_ID=tu_oauth_client_id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=tu_oauth_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=tu_refresh_token_de_gmail
